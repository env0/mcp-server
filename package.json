{
  "name": "@env0/mcp-server",
  "version": "1.1.5",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit"
  },
  "author": "Env0",
  "license": "Apache-2.0",
  "description": "Env0's official MCP server",
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-unused-imports": "4.4.1",
    "nodemon": "3.1.14",
    "prettier": "3.9.10",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "@types/lodash": "4.17.27"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "axios": "^1.18.1",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "morgan": "1.12.1",
    "zod": "4.6.7",
    "lodash": "4.18.1",
    "tsx": "4.23.15"
  }
}
