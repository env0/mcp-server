{
  "name": "@env0/mcp-server",
  "version": "1.1.8",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit"
  },
  "author": "Env0",
  "license": "Apache-2.0",
  "description": "Env0's official MCP server",
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/express": "5.0.6",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.6",
    "nodemon": "3.1.14",
    "oxlint": "1.91.0",
    "prettier": "3.9.10",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "axios": "^1.18.1",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "lodash": "4.18.1",
    "morgan": "1.12.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  }
}
